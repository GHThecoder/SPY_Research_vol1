.env
.env.*
!.env.example
*.pem
credentials.*
secrets.*

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/
*.nbconvert.ipynb

# --- Data (regenerate locally; do not commit market dumps) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/alpha_candidates.yaml

# --- Models / checkpoints ---
*.pt
*.pth
*.ckpt
*.onnx
wandb/
mlruns/
lightning_logs/

# --- Reports ---
# keep the polished PDF + README showcase figures; regenerate the rest after notebooks
reports/figures/*
!reports/figures/.gitkeep
!reports/figures/eqw_vs_singles_equity.png
!reports/figures/ic_by_alpha.png
!reports/figures/benchmarks_equity.png
!reports/figures/ablation_groups.png
*.pdf
!reports/research_report.pdf

# --- OS / IDE ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.idea/
.vscode/
*.swp
*.swo
*~

